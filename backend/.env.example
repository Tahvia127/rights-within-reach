# Copy to backend/.env and fill in real values. backend/.env is gitignored.

# Required for /ask — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Optional (Phase 4, Spanish translation) — https://www.deepl.com/pro-api
DEEPL_API_KEY=

# ---- Request analytics (all optional) ----

# Set to 0 to disable request logging entirely.
ANALYTICS_ENABLED=1

# Where the JSONL log is written (default: data/analytics/requests.jsonl).
ANALYTICS_LOG_PATH=

# Set to 1 to also log raw question text. Off by default -- questions about
# eviction, debt, and abuse are treated as sensitive.
ANALYTICS_LOG_QUESTIONS=0

# Log rotation. Set ANALYTICS_MAX_BYTES=0 to never rotate.
ANALYTICS_MAX_BYTES=10485760
ANALYTICS_BACKUPS=5

# Set to 1 to log a salted hash of each client IP (field "client") for unique
# visitor counts without storing IPs. Requires ANALYTICS_SALT.
ANALYTICS_HASH_IP=0

# Salt for the client hash. Keep it private and stable -- changing it resets
# visitor counts. No salt = no client hash.
ANALYTICS_SALT=